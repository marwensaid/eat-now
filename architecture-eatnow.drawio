        <!-- Legend Box -->
        <mxCell id="legend" value="&lt;b&gt;📚 Stack &amp; Features&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Technologies:&lt;/b&gt; Java 17, Spring Boot 3, Maven, Docker, Kubernetes&lt;br&gt;&lt;b&gt;Résilience:&lt;/b&gt; Resilience4j (Circuit Breaker, Retry: 3x 100ms, Fallback)&lt;br&gt;&lt;b&gt;Observabilité:&lt;/b&gt; Micrometer, Actuator, Prometheus, Grafana&lt;br&gt;&lt;b&gt;API Docs:&lt;/b&gt; Swagger/OpenAPI (/swagger-ui.html)&lt;br&gt;&lt;b&gt;Health Checks:&lt;/b&gt; Liveness &amp; Readiness probes&lt;br&gt;&lt;b&gt;Resources:&lt;/b&gt; CPU: 100m-500m | Memory: 256Mi-512Mi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
